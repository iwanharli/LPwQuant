# Shared config for ingestor (TS) and engine (Python). Copy to .env.

DATABASE_URL=postgres://localhost:5432/db_quant
REDIS_URL=redis://localhost:6379/0

# Helius free plan: https://dashboard.helius.dev — leave empty to run API polling only.
HELIUS_API_KEY=
# Optional overrides (e.g. another provider); take precedence over HELIUS_API_KEY.
RPC_URL=
WS_URL=
# HTTP RPC failover, tried in order after the primary: name=url,name=url
# e.g. RPC_FALLBACKS=public=https://api.mainnet-beta.solana.com
RPC_FALLBACKS=

# Ingestor
METEORA_API_URL=https://dlmm.datapi.meteora.ag
POLL_INTERVAL_SEC=60
POOL_FETCH_LIMIT=1000
POOL_LIMIT=300
MIN_TVL=10000
MIN_VOLUME_24H=50000
WATCH_TOP_N=25
# poll = getMultipleAccounts every WATCH_POLL_INTERVAL_SEC (hemat kredit), ws = accountSubscribe (real-time)
WATCH_MODE=poll
WATCH_POLL_INTERVAL_SEC=10
RETENTION_HOURS=168

# GMGN (read-only). API key is read from GMGN_API_KEY or ~/.config/gmgn/.env (gmgn-cli config --apply).
GMGN_ENABLED=true
GMGN_INFO_REFRESH_MIN=60
GMGN_HOLDERS_REFRESH_MIN=120
GMGN_HOLDERS_TOP_N=100

# Engine
ENGINE_HOST=127.0.0.1
ENGINE_PORT=8000
HISTORY_WINDOW_SEC=7200

# Rencana posisi (engine/app/recommend.py)
PORTFOLIO_USD=1000
MAX_POSITION_PCT=5
HOLD_HOURS=4
# Exit/entry discipline (paper + backtest): only stop-loss / out-of-range exits before MIN_HOLD_HOURS;
# enter only when fees over MIN_HOLD_HOURS >= MIN_FEE_COST_RATIO x round-trip costs.
MIN_HOLD_HOURS=2
MIN_FEE_COST_RATIO=2
# Hours of expected fees the cost gate counts (1 tested best on 7 days of candles).
FEE_GATE_HOURS=1
# Reject plans whose round trip costs more than this % of the position, and cap the stop-loss.
MAX_ROUND_TRIP_COST_PCT=1.5
MAX_STOP_LOSS_PCT=10
# SOL price used for tx costs in the backtest (live uses the SOL pool price).
SOL_USD_FALLBACK=150

# Paper trading (posisi virtual, tidak ada transaksi)
PAPER_ENABLED=true
PAPER_START_EQUITY_USD=1000
PAPER_MAX_OPEN_PER_TIER=5
PAPER_TIERS=low,medium,high
PAPER_COOLDOWN_HOURS=6
PAPER_MIN_POSITION_USD=25
PAPER_MAX_DRAWDOWN_PCT=10
# Biaya eksekusi paper trading
PAPER_COSTS_ENABLED=true
PAPER_TX_COST_SOL=0.00015
PAPER_IMPACT_MULTIPLIER=1.0
PAPER_NEW_BIN_ARRAY_SHARE=0
# Share of base tokens sold back to quote right at close (1 = sell all, 0 = keep the bag)
PAPER_EXIT_SWAP_SHARE=1

# On-chain bin liquidity (fee share per bin, uninitialized bin arrays). ~4 RPC calls per refresh.
BINS_ENABLED=true
BINS_TOP_N=60
BINS_REFRESH_SEC=300
BINS_ARRAYS_EACH_SIDE=2

# Paper trading risk profiles run side by side (engine/app/profiles.py). PAPER_TIERS, PAPER_MAX_OPEN_PER_TIER and
# PAPER_MAX_DRAWDOWN_PCT apply to "moderat"; the other profiles have fixed rules.
PAPER_PROFILES=moderat,tenang,satu_sisi,bolak_balik
# Minimum paper position size (USD), capped by 2% of pool TVL; open positions never exceed the profile equity.
PAPER_POSITION_FLOOR_USD=100

# Telegram alerts. Empty token or chat id = nothing is sent, ever. Keep the real token in .env, never in git.
# Kinds: new_pool (any new DLMM), gate (clears fee >= ratio x cost), new_lp (new and passes the LP filters),
# stale (a data source stopped updating, and when it recovers).
ALERTS_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_KINDS=new_pool,gate,new_lp,stale

# Auto close + sell (dashboard toggle per position). Secret key of a SEPARATE bot wallet holding only LP capital,
# base58 or the [..] array from solana-keygen. Leave empty to keep auto close off. Never commit the real value.
BOT_WALLET_SECRET=

# --- Login passkey (Touch ID) untuk dashboard di server ---
# Wajibkan login. Di laptop biarkan kosong; di VPS isi true.
AUTH_REQUIRED=
# Alamat persis dashboard dibuka, harus https di server. Passkey terikat ke domain ini.
AUTH_ORIGIN=https://quant.domainku.com
# Domain passkey; default diambil dari AUTH_ORIGIN.
AUTH_RP_ID=
# Dipakai dashboard untuk meneruskan permintaan ke engine dan ingestor (keduanya cukup di localhost server).
ENGINE_URL=http://127.0.0.1:8000
CLAIM_URL=http://127.0.0.1:8010

# Port dashboard kalau 3000 sudah dipakai aplikasi lain di server.
DASHBOARD_PORT=

# Backup ditarik ke laptop (scripts/pull-backup.sh)
BACKUP_HOST=root@217.76.51.113
BACKUP_LOCAL_DIR=
BACKUP_KEEP_LOCAL=5
