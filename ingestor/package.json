  "private": true,
  "description": "Live Meteora DLMM pool data: API poller + on-chain websocket watcher",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "backfill": "tsx src/backfill.ts",
    "typecheck": "tsc --noEmit",
